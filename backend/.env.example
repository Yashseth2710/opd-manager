# Copy to .env and fill in. Never commit .env.

# Which environment this is. development | preview | production | test
ENVIRONMENT=development

# Neon, pooled endpoint. Used by the application.
# Paste the string Neon gives you; the query parameters are stripped for you.
DATABASE_URL=

# Neon, direct endpoint (no -pooler in the host). Used by Alembic.
DATABASE_DIRECT_URL=

# Signs access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leaving it blank generates one per process, which signs everyone out on restart.
JWT_SECRET=

# Upstash Redis, REST interface. Holds refresh tokens, reset tokens and rate
# limit counters. A serverless function cannot keep a Redis connection open
# between invocations, so this speaks HTTP rather than TCP.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Where the links in outgoing email point.
APP_URL=http://localhost:3000

# Transactional email. Leave both keys blank to run without a provider: links
# are written to the server log instead of sent, and new accounts are created
# already confirmed so the application stays usable.
#
# Brevo confirms a single sender address rather than a whole domain, so mail
# reaches any recipient without owning one. Set MAIL_FROM to the address you
# confirmed with them, or they refuse the message.
BREVO_API_KEY=
#
# Resend needs a verified sending domain. Until there is one it only delivers
# to the address that owns the account, so prefer it once a domain exists.
RESEND_API_KEY=
#
MAIL_FROM=OPD Manager <you@example.com>

# Vercel Blob, where patient documents are kept. Create a private store and
# paste its read-write token. Left blank in development, files are written to
# backend/.files instead; anywhere else, uploads are refused until it is set.
BLOB_READ_WRITE_TOKEN=

# Razorpay, for paying a bill online. Test keys come from the dashboard with
# no paperwork; live keys need the business verified first. Left blank, the
# desk still takes cash, UPI and cards by hand and the option to send a
# patient a link is simply not offered.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
#
# Set the same value here and on the webhook in the Razorpay dashboard. It is
# what proves a webhook came from them and not from someone who guessed the
# URL, so a blank one means webhooks are refused.
RAZORPAY_WEBHOOK_SECRET=
